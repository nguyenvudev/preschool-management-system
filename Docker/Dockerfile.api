# --- BASE IMAGE (runtime)
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS base
WORKDIR /app
EXPOSE 8080

# --- BUILD IMAGE (sdk)
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy project files first (for caching)
COPY ["PreschoolManagementSystem.Api/PreschoolManagementSystem.Api.csproj", "PreschoolManagementSystem.Api/"]
COPY ["PreschoolManagementSystem.Application/PreschoolManagementSystem.Application.csproj", "PreschoolManagementSystem.Application/"]
COPY ["PreschoolManagementSystem.Infrastructure/PreschoolManagementSystem.Infrastructure.csproj", "PreschoolManagementSystem.Infrastructure/"]
COPY ["PreschoolManagementSystem.Domain/PreschoolManagementSystem.Domain.csproj", "PreschoolManagementSystem.Domain/"]

# Restore dependencies
RUN dotnet restore "PreschoolManagementSystem.Api/PreschoolManagementSystem.Api.csproj"

# Copy everything else
COPY . .

# Build application
WORKDIR "/src/PreschoolManagementSystem.Api"
RUN dotnet build -c Release -o /app/build

# --- PUBLISH STAGE
FROM build AS publish
RUN dotnet publish -c Release -o /app/publish

# --- FINAL IMAGE
FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "PreschoolManagementSystem.Api.dll"]